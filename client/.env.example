# Local development: copy this file to .env.local.
# On Vercel, add the same values under Project Settings > Environment Variables.

# Public origin of this application. Omit it for dynamic Vercel preview URLs.
# For local SSO, open this exact hostname in the browser.
APP_BASE_URL=http://careeros.localhost:3000

# Auth0 Regular Web Application settings.
# AUTH0_DOMAIN is the hostname only: no scheme and no trailing slash.
AUTH0_DOMAIN=YOUR-TENANT.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 32-byte hexadecimal cookie encryption key. Generate with:
#   openssl rand -hex 32
AUTH0_SECRET=

# Auth0 API Identifier. It must match server Oidc:Audience.
AUTH0_AUDIENCE=https://skillbridge-api

# CareerOS ASP.NET Core API, called only from the Next.js server.
SERVER_URL=http://127.0.0.1:4000

# Companion application API and browser URL.
SKILLS_API_URL=http://skillforge.localhost:3002
SKILLS_APP_URL=http://skillforge.localhost:3002
