# Local development: copy to .env.local
# On Vercel: Project Settings -> Environment Variables

# Public origin of this application. No trailing slash.
# Open the site at THIS host, not at the "localhost" line Next prints:
# cookies are bound to a host, and a sign-in started on the wrong one leaves
# its cookie behind. proxy.ts redirects in development if you forget.
BASE_URL=http://careeros.localhost:3000

# Auth0 tenant domain, with scheme and no trailing slash.
OIDC_ISSUER=https://YOUR-TENANT.eu.auth0.com

# Auth0 -> Applications -> CareerOS -> Settings
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Auth0 -> Applications -> APIs -> Identifier. Identical in every service.
API_AUDIENCE=https://skillbridge-api

# At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Our own ASP.NET Core API. Called server to server, never by the browser.
# 127.0.0.1 rather than a *.localhost name: Node does not resolve those.
SERVER_URL=http://127.0.0.1:4000

# The other team's API and application.
SKILLS_API_URL=http://skillforge.localhost:3002
SKILLS_APP_URL=http://skillforge.localhost:3002
