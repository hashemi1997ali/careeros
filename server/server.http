@server_HostAddress = http://localhost:4000
@accessToken = paste-auth0-access-token-here
@skillId = 1
@projectId = 1
@applicationId = 1

GET {{server_HostAddress}}/health/live
Accept: application/json

###

GET {{server_HostAddress}}/health/ready
Accept: application/json

###

POST {{server_HostAddress}}/api/users/sync
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{server_HostAddress}}/api/users/me
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{server_HostAddress}}/api/skills?search=net&level=Intermediate
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{server_HostAddress}}/api/skills
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "ASP.NET Core",
  "category": "Backend",
  "level": "Intermediate",
  "startDate": "2025-08-01"
}

###

GET {{server_HostAddress}}/api/skills/{{skillId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PUT {{server_HostAddress}}/api/skills/{{skillId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "ASP.NET Core",
  "category": "Backend",
  "level": "Advanced",
  "startDate": "2025-08-01"
}

###

POST {{server_HostAddress}}/api/projects
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "CareerOS",
  "description": "A career management platform for skills, projects, and applications.",
  "repositoryUrl": "https://github.com/example/careeros",
  "liveUrl": null,
  "skillIds": [{{skillId}}]
}

###

GET {{server_HostAddress}}/api/projects?skillId={{skillId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{server_HostAddress}}/api/projects/{{projectId}}/skills/{{skillId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{server_HostAddress}}/api/job-applications
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "company": "Example GmbH",
  "position": "Junior .NET Developer",
  "jobUrl": "https://example.com/jobs/1",
  "location": "Berlin",
  "salary": 50000,
  "status": "Applied",
  "notes": "Applied through the company website.",
  "jobDescription": "ASP.NET Core, PostgreSQL, Docker and Azure are required.",
  "requirements": [
    { "name": "ASP.NET Core", "isRequired": true },
    { "name": "PostgreSQL", "isRequired": true },
    { "name": "Docker", "isRequired": true },
    { "name": "Azure", "isRequired": false }
  ]
}

###

GET {{server_HostAddress}}/api/job-applications?status=Applied
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PATCH {{server_HostAddress}}/api/job-applications/{{applicationId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "HrInterview"
}

###

GET {{server_HostAddress}}/api/job-applications/{{applicationId}}/match
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{server_HostAddress}}/api/dashboard
Authorization: Bearer {{accessToken}}
Accept: application/json
